# Project Atlas Configuration

# Environment mode: development, staging, production
ENVIRONMENT=development

# Service Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=atlas-secret-key-prod-2025

# Database Configuration (MySQL 8)
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=atlas_db
MYSQL_USER=atlas_app
MYSQL_PASSWORD=atlas_app_secret
MYSQL_ROOT_PASSWORD=atlas_root_secret

# Read-Only Database User for Question-Answering SQL Tool
MYSQL_RO_USER=atlas_readonly
MYSQL_RO_PASSWORD=atlas_ro_secret

# Qdrant Vector Database
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=market_research_reports

# LLM & Embedding Provider
# Choices: openai, ollama, local
LLM_PROVIDER=ollama
LLM_MODEL=mistral:latest
LLM_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=your_openai_api_key_here

# Embedding Configuration
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Agent & Guardrails
CONFIDENCE_THRESHOLD=0.70
MAX_QUESTION_LENGTH=500
ENABLE_INJECTION_DETECTOR=true

# Observability
LOG_LEVEL=INFO
ENABLE_JSON_LOGS=true
