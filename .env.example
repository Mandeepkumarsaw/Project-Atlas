# Project Atlas Configuration Example
# Copy this file to .env and provide your deployment-specific credentials

# Environment mode: development, staging, production
ENVIRONMENT=development

# Service Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=your_secure_service_api_key_here
ADMIN_API_KEY=your_secure_admin_api_key_here

# Client-Specific Scoped API Keys (Enforces Client Isolation)
CLIENT_C01_KEY=your_secure_c01_client_key_here
CLIENT_C02_KEY=your_secure_c02_client_key_here
CLIENT_C03_KEY=your_secure_c03_client_key_here

# CORS Origin Allowlist (comma-separated list of trusted origins)
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:8080,http://127.0.0.1:8080

# Database Configuration (MySQL 8)
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=atlas_db
MYSQL_USER=atlas_app
MYSQL_PASSWORD=your_secure_mysql_password_here
MYSQL_ROOT_PASSWORD=your_secure_mysql_root_password_here

# Read-Only Database User for Question-Answering SQL Tool (Enforces Read-Only Privilege)
MYSQL_RO_USER=atlas_readonly
MYSQL_RO_PASSWORD=your_secure_mysql_ro_password_here

# Qdrant Vector Database
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=market_research_reports

# LLM & Embedding Provider
# Choices: openai, ollama, local
LLM_PROVIDER=ollama
LLM_MODEL=mistral:latest
LLM_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=your_openai_api_key_here

# Embedding Configuration
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Agent & Guardrails
CONFIDENCE_THRESHOLD=0.70
MAX_QUESTION_LENGTH=500
ENABLE_INJECTION_DETECTOR=true

# Observability
LOG_LEVEL=INFO
ENABLE_JSON_LOGS=true

